# IT InternTrack - configuration template
#
# Copy to .env and fill in. NEVER commit the real .env: it holds the keys that
# protect intern personal data.
#
#   cp backend/.env.example backend/.env
#
# Generate the three secrets with:
#   openssl rand -hex 32                              -> SECRET_KEY
#   python -m app.cli generate-key                    -> FERNET_KEYS
#   python -m app.cli generate-blind-index-key        -> BLIND_INDEX_KEY

# --- Identity ---------------------------------------------------------------
APP_NAME=IT InternTrack
COMPANY_NAME=Your Company Name
ORGANIZATION_NAME=Information Technology Department
# Leave DEBUG false in production: it downgrades the missing-encryption error
# from a startup failure to a warning.
DEBUG=false

# --- Database ---------------------------------------------------------------
# Development / single instance:
DATABASE_URL=sqlite:///./interntrack.db
# Production (recommended):
# DATABASE_URL=postgresql+psycopg://interntrack:CHANGE_ME@dbhost:5432/interntrack
#
# Supabase Cloud, direct connection - use this for migrations and serving:
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
#
# Supabase transaction pooler (port 6543). Prepared statements and pooling are
# reconfigured automatically when this endpoint is detected. Do NOT run
# migrations against 6543 - use 5432.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Self-hosted Supabase on your own network:
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/postgres
#
# See docs/SUPABASE.md for which endpoint to use and the data-residency
# considerations for intern personal data.
SQL_ECHO=false

# Connection pool, for a DIRECT PostgreSQL connection only. Ignored behind a
# transaction-mode pooler, where the pooler does the pooling.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Security ---------------------------------------------------------------
# Signs the JWTs. Changing it invalidates every active session.
SECRET_KEY=CHANGE-ME-run-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=12

# --- Field-level encryption (Fernet) ----------------------------------------
# Comma-separated keys. The FIRST key encrypts; all keys are tried on decrypt,
# which is what lets you rotate without downtime:
#   1. prepend the new key      FERNET_KEYS=<new>,<old>
#   2. python -m app.cli rotate-encryption
#   3. remove <old>
#
# WARNING: lose these keys and the encrypted columns (intern email, contact
# numbers, emergency contacts) become permanently unreadable. Back them up
# separately from the database, not alongside it.
FERNET_KEYS=
# Separate key for the deterministic lookup indexes on encrypted columns.
# Changing it invalidates stored indexes; re-run rotate-encryption afterwards.
BLIND_INDEX_KEY=
# Refuse to start without encryption keys. Keep true in production.
REQUIRE_ENCRYPTION=true

# --- Business timezone ------------------------------------------------------
# Drives business dates, shift boundaries and every report.
BUSINESS_TIMEZONE=Asia/Manila

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880

# --- CORS -------------------------------------------------------------------
# The frontend origins allowed to call this API.
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
